<Window x:Class="MiningSupervisor.Views.SurveyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Survey" Width="300" MinWidth="220" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanResize" Background="#000000"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="HeaderSquareButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#101010" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2">
                            <Border x:Name="Fill" Background="{TemplateBinding Foreground}" Margin="2" Opacity="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8a8a8a"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <StackPanel Grid.IsSharedSizeScope="True">
        <Grid Height="20">
            <TextBlock Text="Survey" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                <Button Style="{StaticResource HeaderSquareButton}" Foreground="#a259d9"
                        ToolTip="Clear scans" Click="Reset_Click"/>
                <Button Style="{StaticResource HeaderSquareButton}" Foreground="#e03a2f"
                        ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="HintText" Style="{StaticResource Label}" Margin="8,6,8,8" TextWrapping="Wrap"
                   Text="Copy a survey scan to the clipboard to analyze it."/>

        <StackPanel x:Name="ResultPanel" Margin="8,4,8,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Total" Style="{StaticResource Label}" Margin="0,2,12,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalText" Style="{StaticResource Value}" HorizontalAlignment="Right" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="Rate" Style="{StaticResource Label}" Margin="0,2,12,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RateText" Style="{StaticResource Value}" HorizontalAlignment="Right" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Depletion in" Style="{StaticResource Label}" Margin="0,2,12,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DepletionText" Style="{StaticResource Value}" HorizontalAlignment="Right" Margin="0,2"/>
            </Grid>

            <Rectangle Height="1" Fill="#2a2a2a" Margin="0,8,0,0"/>

            <TextBlock x:Name="DetailsToggle" Text="▾ Details" Style="{StaticResource Label}" Cursor="Hand"
                       Margin="0,4" Background="Transparent" ToolTip="Show/hide the detailed list"
                       MouseLeftButtonDown="DetailsToggle_MouseLeftButtonDown"/>

            <ItemsControl x:Name="RowList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Units"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Type}" Style="{StaticResource Value}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding M3Label}" Style="{StaticResource Value}"
                                       HorizontalAlignment="Right" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding UnitsLabel}" Style="{StaticResource Label}"
                                       HorizontalAlignment="Right" Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</Window>
