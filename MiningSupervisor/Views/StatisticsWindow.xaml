<Window x:Class="MiningSupervisor.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics" Width="240" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Background="#000000"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="HeaderSquareButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#101010" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2">
                            <Border x:Name="Fill" Background="{TemplateBinding Foreground}" Margin="2" Opacity="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8a8a8a"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Grid Height="20">
            <TextBlock Text="Statistics" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                <Button Style="{StaticResource HeaderSquareButton}" Foreground="#a259d9"
                        ToolTip="Reset session" Click="Reset_Click"/>
                <Button Style="{StaticResource HeaderSquareButton}" Foreground="#e03a2f"
                        ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Grid Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Total" Style="{StaticResource Label}" Margin="0,2,12,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalText" Style="{StaticResource Value}" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="Extra" Style="{StaticResource Label}" Margin="0,2,12,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ExtraText" Style="{StaticResource Value}" Margin="0,2"/>
            <TextBlock Grid.Row="2" Text="Loss" Style="{StaticResource Label}" Margin="0,2,12,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LossText" Style="{StaticResource Value}" Margin="0,2"/>
            <TextBlock Grid.Row="3" Text="Session Length" Style="{StaticResource Label}" Margin="0,10,12,2"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LengthText" Style="{StaticResource Value}" Margin="0,10,0,2"/>
        </Grid>
    </StackPanel>
</Window>
