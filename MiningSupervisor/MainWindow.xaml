<Window x:Class="MiningSupervisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiningSupervisor"
        xmlns:vm="clr-namespace:MiningSupervisor.ViewModels"
        mc:Ignorable="d"
        Title="Mining Supervisor" Width="240" MinWidth="160" MinHeight="40"
        SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#000000"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="EveFont">Segoe UI, Tahoma</FontFamily>

        <!-- Small square header button in the style of the in-game window controls. -->
        <Style x:Key="HeaderSquareButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#101010" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2">
                            <Border x:Name="Fill" Background="{TemplateBinding Foreground}" Margin="2" Opacity="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat, square, EVE-style meter. -->
        <Style x:Key="CargoProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#4caf50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Thin strip along the top edge showing the compressed-ore portion of the cargo. -->
        <Style x:Key="CargoProgressBarOverlay" TargetType="ProgressBar" BasedOn="{StaticResource CargoProgressBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a259d9"/>
        </Style>

        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource EveFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="Foreground" Value="#d0d0d0"/>
        </Style>
    </Window.Resources>

    <Border BorderThickness="0">
        <StackPanel>
            <!-- Header: drag area + square buttons (red = placeholder, orange = empty all, purple = options) -->
            <Grid Height="20" Background="#000000">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Button Style="{StaticResource HeaderSquareButton}" Foreground="#a259d9"
                            ToolTip="Empty all cargo" Click="ClearAllCargo_Click"/>
                    <Button Style="{StaticResource HeaderSquareButton}" Foreground="#f29a1f"
                            ToolTip="Statistics" Click="Statistics_Click"/>
                    <Button Style="{StaticResource HeaderSquareButton}" Foreground="#ffffff"
                            ToolTip="Options" Click="Settings_Click"/>
                    <Button Style="{StaticResource HeaderSquareButton}" Foreground="#e03a2f"
                            ToolTip="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="CharacterList" Margin="3,0,3,3">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CharacterCardViewModel}">
                        <StackPanel Margin="0,0,0,0" Background="Transparent">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Empty Cargo" Command="{Binding EmptyCommand}"/>
                                    <MenuItem Header="Set Cargo Capacity..." Click="EditCharacter_Click" Tag="{Binding}"/>
                                    <Separator/>
                                    <MenuItem Header="Remove Character" Click="RemoveCharacter_Click" Tag="{Binding}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Grid>
                                <ProgressBar Style="{StaticResource CargoProgressBar}" Foreground="{Binding CargoColor}"
                                             Minimum="0" Maximum="100" Value="{Binding PercentFull, Mode=OneWay}"/>
                                <ProgressBar Style="{StaticResource CargoProgressBarOverlay}"
                                             Minimum="0" Maximum="100" Value="{Binding CompressedPercentFull, Mode=OneWay}"/>
                            </Grid>
                            <Grid Margin="4,2,4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BarText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding CapacityShortLabel}" Style="{StaticResource BarText}"
                                           Margin="6,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding PercentLabel}" Style="{StaticResource BarText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding UnknownOre, StringFormat='Unknown ore: {0} (add its volume in settings)'}"
                                       Foreground="#e06c6c" FontSize="10" Margin="2,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasUnknownOre, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
